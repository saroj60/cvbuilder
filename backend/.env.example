# =========================================================================
# AI Recruitment Backend Configuration - Production & Supabase Deployment
# =========================================================================

# Server environment configuration
PORT=5000
NODE_ENV=production

# Database Connection (Supabase PostgreSQL Connection Details)
#
# 1. TRANSACTION POOLER (Port 6543) - Recommended for production hosting (Render, Railway, etc.):
#    DATABASE_URL="postgres://postgres.yourprojectref:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# 2. DIRECT CONNECTION (Port 5432) - Required for Prisma schema migrations (prisma db push):
#    DIRECT_URL="postgres://postgres.yourprojectref:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
#
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_recruitment_db"

# JWT Token configuration
# Generate a highly secure random string for JWT_SECRET in production
JWT_SECRET="generate-a-secure-jwt-secret-string-here"
JWT_EXPIRES_IN="7d"

# CORS configuration
# Must match your frontend Vercel deployment URL (without trailing slash)
CORS_ORIGIN="https://your-resume-builder.vercel.app"

# AI Integration - Google Gemini API Key
# Sign up at Google AI Studio to get your Gemini API Key
GEMINI_API_KEY="your-gemini-api-key"
